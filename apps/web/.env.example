# Groundline frontend environment (names only — never put a secret here).
#
# The frontend holds NO credentials. Every model key lives in the backend.
# NEXT_PUBLIC_* values are inlined into the browser bundle, so only put
# non-secret configuration here.

# Where the FastAPI backend is reachable. Defaults to http://localhost:8000
# when unset (see src/lib/config.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
